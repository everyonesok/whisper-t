# Copy this file to .env and paste your own key in.
#
#     cp .env.example .env
#
# Get a key from https://console.anthropic.com under Settings → API Keys.
# No quotes around the value, no spaces around the "=".
#
# .env is gitignored. Never commit a real key — if one is ever exposed,
# revoke it in the console and generate a new one.

ANTHROPIC_API_KEY=sk-ant-your-key-here
